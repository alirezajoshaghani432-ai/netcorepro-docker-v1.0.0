# NetCore Pro — Environment Variables
# این فایل را به .env کپی کنید و مقادیر را پر کنید.

# ============== کلید JWT (حتماً تغییر دهید) ==============
# تولید مقدار قوی:  openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_HEX_STRING_AT_LEAST_64_CHARS

# ============== سرور ==============
NODE_ENV=production
PORT=8090
MAX_BODY_SIZE_MB=10

# ============== CORS ==============
# دامنه‌های مجاز — با ویرگول جدا کنید یا * برای همه
CORS_ORIGINS=*

# ============== دیتابیس (پیش‌فرض: Microsoft SQL Server) ==============
DB_TYPE=mssql
MSSQL_SERVER=127.0.0.1
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=CHANGE_ME_Strong!Passw0rd
MSSQL_DATABASE=netcorepro
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# MySQL/MariaDB (فقط اگر DB_TYPE=mysql)
# DB_TYPE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=netcore
# MYSQL_PASSWORD=CHANGE_ME
# MYSQL_DATABASE=netcorepro

# SQLite (فقط توسعه محلی / نسخه قدیمی) ─ در صورت DB_TYPE=sqlite
# DB_TYPE=sqlite
# DB_PATH=./data/netcorepro.db
