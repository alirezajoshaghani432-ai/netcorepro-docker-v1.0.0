<?xml version="1.0" encoding="UTF-8"?>
<!--
  NetCore Pro - IIS reverse-proxy + iisnode configuration
  Two deployment modes:
    1. iisnode (recommended): IIS hosts Node.js directly via iisnode module.
    2. ARR (reverse proxy): IIS forwards traffic to Node running on port 3000.

  This file uses MODE 1 (iisnode). For MODE 2 see web.config.arr.
-->
<configuration>
  <system.webServer>

    <!-- Handler: route all traffic to dist/server.js via iisnode -->
    <handlers>
      <add name="iisnode" path="dist/server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- iisnode settings -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      watchedFiles="web.config;*.js;node_modules\*"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      uncFileChangesPollingInterval="5000"
      gracefulShutdownTimeout="60000"
      enableXFF="true"
      promoteServerVars=""
    />

    <!-- URL Rewrite: clean URLs -> dist/server.js -->
    <rewrite>
      <rules>
        <!-- Don't rewrite static files served from /public -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(static|uploads|favicon\.ico|robots\.txt|sitemap\.xml)(.*)$" />
          <action type="Rewrite" url="public/{R:1}{R:2}" />
        </rule>

        <!-- All other requests go to Node app -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
          </conditions>
          <action type="Rewrite" url="dist/server.js"/>
        </rule>
      </rules>
    </rewrite>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/json" enabled="true"/>
        <add mimeType="application/javascript" enabled="true"/>
        <add mimeType="text/html" enabled="true"/>
        <add mimeType="text/css" enabled="true"/>
      </dynamicTypes>
    </httpCompression>

    <!-- Static file cache (1 year for assets) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Hide iisnode log directory from public access -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="iisnode" />
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="logs" />
          <add segment="src" />
          <add segment=".env" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

    <!-- Default document -->
    <defaultDocument>
      <files>
        <clear/>
        <add value="dist/server.js"/>
      </files>
    </defaultDocument>

  </system.webServer>
</configuration>
