# =============================================================================
#  NetCore Pro — environment configuration
#  Author: A.K
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in the values before the first start:
#      cp .env.example .env
#  Generate a strong secret and write it in place:
#      sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 64)|" .env
#  The container REFUSES to boot in production while JWT_SECRET is a
#  placeholder or shorter than 32 characters.
# =============================================================================

# ----------------------------- Security (required) ---------------------------
# Signs the admin/customer JWTs. Changing it invalidates every active session.
# Generate with:  openssl rand -hex 64
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_64

# ------------------------------- HTTP server ---------------------------------
# Host port the site is published on. The container always listens on 3000.
APP_PORT=8090

# Ports used only when the optional `proxy` profile is enabled.
HTTP_PORT=80
HTTPS_PORT=443

# Maximum JSON/upload body size accepted by /api/* endpoints, in megabytes.
MAX_BODY_SIZE_MB=10

# --------------------------------- CORS --------------------------------------
# `*` is fine while the API is only consumed by its own front-end.
# For a separate front-end domain use a comma-separated allow-list, e.g.
#   CORS_ORIGINS=https://netcorepro.ir,https://www.netcorepro.ir
CORS_ORIGINS=*

# ------------------------------- Database ------------------------------------
# SQLite is the supported and tested driver. The path points inside the
# container; on the host it lives in the `netcorepro_data` Docker volume.
DB_TYPE=sqlite
DB_PATH=/app/data/netcorepro.db

# ------------------------------ Localisation ---------------------------------
TZ=Asia/Tehran

# ---------------------------- Resource ceilings ------------------------------
CPU_LIMIT=1.5
MEM_LIMIT=768M

# ------------------------------- Build-time ----------------------------------
# npm mirror used while building the image. Replace with
# https://registry.npmjs.org/ on a server with unrestricted internet access.
NPM_REGISTRY=https://package-mirror.liara.ir/repository/npm/
