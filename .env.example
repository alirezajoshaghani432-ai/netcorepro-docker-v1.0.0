# رادیس — Environment Variables
# این فایل را به .env کپی کنید و مقادیر را پر کنید.
# docker compose متغیرها را از همین .env می‌خواند (interpolation).

# ============== کلید JWT (حتماً تغییر دهید) ==============
# تولید مقدار قوی:  openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_HEX_STRING_AT_LEAST_64_CHARS

# ============== سرور ==============
NODE_ENV=production
PORT=8090
MAX_BODY_SIZE_MB=10

# ============== CORS ==============
# دامنه‌های مجاز — با ویرگول جدا کنید یا * برای همه
CORS_ORIGINS=*

# ============== دیتابیس ==============
# پیش‌فرض MySQL/MariaDB (توصیه‌شده برای production)
DB_TYPE=mysql
# برای npm start روی خود ماشین: 127.0.0.1
# داخل docker compose مقدار MYSQL_HOST توسط compose روی «db» override می‌شود
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=netcore
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=netcorepro
# پسورد root فقط برای کانتینر MariaDB (first-boot). روی volume موجود عوض نمی‌شود.
# اگر خالی بماند compose از مقدار پیش‌فرض change-me-root استفاده می‌کند.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# SQLite (فقط توسعه محلی / نسخه قدیمی) ─ در صورت DB_TYPE=sqlite
# DB_TYPE=sqlite
# DB_PATH=./data/netcorepro.db
